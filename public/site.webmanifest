{
  "name": "editor.app.br - Editor de Documentos Online",
  "short_name": "editor.app.br",
  "description": "Suíte de escritório online moderna e gratuita (Word, Excel, PowerPoint, PDF). 100% privada e local-first.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#059669",
  "orientation": "any",
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "categories": ["productivity", "utilities", "business"],
  "shortcuts": [
    {
      "name": "Novo Documento Word",
      "short_name": "Word",
      "description": "Criar novo documento de texto (.docx)",
      "url": "/editor?new=docx",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nova Planilha Excel",
      "short_name": "Excel",
      "description": "Criar nova planilha eletrônica (.xlsx)",
      "url": "/editor?new=xlsx",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nova Apresentação",
      "short_name": "Slides",
      "description": "Criar nova apresentação de slides (.pptx)",
      "url": "/editor?new=pptx",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
